{
  "name": "flixleo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop": "electron desktop/main.cjs",
    "desktop:dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ffmpeg-static": "^5.2.0",
    "shaka-player": "^4.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "description": "FlixLeo Windows desktop app and web platform",
  "build": {
    "appId": "cyou.flixleo.desktop",
    "productName": "FlixLeo",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FlixLeo-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FlixLeo-Portable-${version}-${arch}.${ext}"
    }
  },
  "main": "desktop/main.cjs",
  "author": "FlixLeo"
}
